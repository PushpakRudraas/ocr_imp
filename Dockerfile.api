FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
# libgl1/libglib2.0-0: OpenCV runtime libs pulled in by rapidocr-onnxruntime
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-services.txt .
# torch first, from an explicit index. Default = CUDA 12.8 wheels: needed for RTX 50-series (Blackwell) GPUs and fine for older
# ones; the same wheel runs on the CPU when a container gets no GPU. Build a smaller CPU-only image with
#   docker compose build --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cpu
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
RUN pip install --default-timeout=300 --retries 10 torch torchvision --index-url ${TORCH_INDEX}
RUN pip install -r requirements-services.txt
COPY newspaper_pipeline ./newspaper_pipeline
# ad_yolo.pt (YOLO ad/article detector) and doclayout.pt (page layout blocks): see models/README.md
COPY models ./models
RUN useradd --create-home --uid 10001 app && mkdir /data /models && chown app /data /models
ENV HF_HOME=/models NP_AD_MODEL=/app/models/ad_yolo.pt NP_LAYOUT_MODEL=/app/models/doclayout.pt
USER app
EXPOSE 8000
CMD ["uvicorn", "newspaper_pipeline.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
