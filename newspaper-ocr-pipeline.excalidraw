   "version": 1,
   "versionNonce": 648200382,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The enrichment job carries pointers only (run_id, run_date, clean event_ids); the enrich-worker reads the articles from MongoDB.",
   "originalText": "The enrichment job carries pointers only (run_id, run_date, clean event_ids); the enrich-worker reads the articles from MongoDB.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "lg2",
   "type": "text",
   "x": 20,
   "y": 990,
   "width": 1152.8000000000002,
   "height": 20.0,
   "angle": 0,
