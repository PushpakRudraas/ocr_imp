   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Only datasync writes pipeline documents to MongoDB: workers publish to Kafka. A run is DONE only once its documents are stored.",
   "originalText": "Only datasync writes pipeline documents to MongoDB: workers publish to Kafka. A run is DONE only once its documents are stored.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "lg1",
   "type": "text",
   "x": 20,
   "y": 960,
   "width": 1126.4,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#757575",
