   "versionNonce": 756849393,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Enrichment is opt-in (UI switch, or the Run enrichment button on a finished run). Delivery is at-least-once, every write an upsert.",
   "originalText": "Enrichment is opt-in (UI switch, or the Run enrichment button on a finished run). Delivery is at-least-once, every write an upsert.",
