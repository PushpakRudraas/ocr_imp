# Copy to .env and change the passwords for anything that is not a throwaway laptop.
# URIs in docker-compose.yml embed these, so keep them URL-safe (letters, digits, - _ .).
MONGO_USER=newspaper
MONGO_PASSWORD=newspaper-dev
POSTGRES_USER=newspaper
POSTGRES_PASSWORD=newspaper-dev
POSTGRES_DB=newspaper
NEO4J_PASSWORD=newspaper-dev

# published ports (infra ports bind to 127.0.0.1 only)
WEB_PORT=8181
API_PORT=8000
MONGO_PORT=27017
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# pipeline backends inside the api container
NP_OCR=auto            # auto = RapidOCR (installed in the image); none disables scanned-PDF OCR
NP_TRANSLATOR=aws      # none | aws  (aws needs the AWS_* variables below)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# real NLP models (HuggingFace, downloaded into the hf-models volume on first run, ~3 GB)
NP_EMBEDDER=minilm     # hashing | minilm | bge-m3   (minilm = paraphrase-multilingual-MiniLM-L12-v2, 384-dim)
NP_ENRICH_MODELS=hf    # none | hf   (NER, zero-shot topic, sentiment, emotion)
NP_DEVICE=cuda         # enrichment device: cuda (GPU, fail if unusable) | auto (GPU if usable) | cpu
# TORCH_INDEX=https://download.pytorch.org/whl/cpu   # build arg: CPU-only torch for a smaller image (default: CUDA 12.8)

# every hop goes through Kafka: api -> extract-worker -> datasync (writes MongoDB) -> enrich-worker -> datasync
NP_KAFKA_TOPIC=newspaper.jobs.enrich
